{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node /절대경로/code-map/hooks/notify.mjs", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node /절대경로/code-map/hooks/notify.mjs", "async": true }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|MultiEdit|Write|NotebookEdit", "hooks": [{ "type": "command", "command": "node /절대경로/code-map/hooks/notify.mjs", "async": true }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|MultiEdit|Write|NotebookEdit", "hooks": [{ "type": "command", "command": "node /절대경로/code-map/hooks/notify.mjs", "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node /절대경로/code-map/hooks/notify.mjs", "async": true }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node /절대경로/code-map/hooks/notify.mjs", "async": true }] }
    ]
  }
}
