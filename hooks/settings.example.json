{
  "hooks": {
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "node /절대경로/live-code-map/hooks/notify.mjs", "timeout": 10}]}
    ],
    "PreToolUse": [
      {"matcher": "Edit|MultiEdit|Write|NotebookEdit", "hooks": [{"type": "command", "command": "node /절대경로/live-code-map/hooks/notify.mjs", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|MultiEdit|Write|NotebookEdit", "hooks": [{"type": "command", "command": "node /절대경로/live-code-map/hooks/notify.mjs", "timeout": 10}]},
      {"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "node /절대경로/live-code-map/hooks/notify.mjs", "timeout": 15}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "node /절대경로/live-code-map/hooks/notify.mjs", "timeout": 10}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "node /절대경로/live-code-map/hooks/notify.mjs", "timeout": 10}]}
    ]
  }
}
